{
  "config": {
    "flow_title": "{name}",
    "step": {
      "user": {
        "title": "Choose a Grundfos pump",
        "description": "Pumps heard by a connectable Bluetooth proxy.",
        "data": {
          "address": "Pump"
        }
      },
      "bluetooth_confirm": {
        "title": "Pair with {name}",
        "description": "After you submit this form, press the Bluetooth button on the pump. The pump accepts pairing for only about three seconds after the press, so press it once the waiting screen appears, not before.\n\nAddress: {address}\nConnectable proxies hearing the pump: {connectable}\nPassive scanners hearing the pump (cannot connect): {passive}"
      },
      "pair_failed": {
        "title": "Pairing did not succeed",
        "description": "Submit to try again, then press the pump's Bluetooth button as soon as the waiting screen appears."
      },
      "reauth_confirm": {
        "title": "Pair {name} again",
        "description": "The pump no longer accepts the encrypted link from Home Assistant. This is expected when the proxy holding the pairing was replaced or wiped. Submit, then press the pump's Bluetooth button.\n\nConnectable proxies hearing the pump: {connectable}"
      },
      "reconfigure": {
        "title": "Pair {name} again",
        "description": "Pair the pump with the proxy that now hears it best. Submit, then press the pump's Bluetooth button.\n\nConnectable proxies hearing the pump: {connectable}"
      }
    },
    "progress": {
      "pair": "Press the Bluetooth button on {name} now. Waiting up to a minute for the pump to open its pairing window, then connecting."
    },
    "error": {
      "no_connectable_proxy": "No Bluetooth proxy that can make connections hears this pump. An ESPHome proxy with active connections enabled is needed within a few metres of the pump; Shelly devices only listen.",
      "button_timeout": "The pump did not report a button press within a minute.",
      "window_missed": "The pump refused pairing: the connection through {source} took {seconds} s and arrived after the three-second window, or the button was pressed too early. Try again and press the button as soon as the waiting screen shows.",
      "cannot_connect": "Could not connect through {source}: {reason}",
      "no_longer_in_range": "The pump is not advertising right now. Make sure it has power (a thermostat may have switched it off).",
      "unsupported_model": "This Grundfos device (family {family}, type {type}) is not supported yet.",
      "unknown": "Unexpected error. The Home Assistant log has the details."
    },
    "abort": {
      "already_configured": "Device is already configured",
      "already_in_progress": "Configuration flow is already in progress",
      "no_devices_found": "No devices found on the network",
      "not_supported": "This Bluetooth device does not advertise like a Grundfos pump.",
      "unsupported_model": "This Grundfos device (family {family}, type {type}) is not supported yet. Please open an issue with these numbers.",
      "reauth_successful": "Re-authentication was successful",
      "reconfigure_successful": "Re-configuration was successful"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Polling",
        "data": {
          "scan_interval": "Seconds between readings"
        },
        "data_description": {
          "scan_interval": "Each reading opens a short Bluetooth connection (under five seconds). While Home Assistant is connected the Grundfos GO app cannot connect."
        }
      }
    }
  },
